1b[38;5;6m[ ]\u001b[0m prev/next turn\u001b[0m\u001b[2m \u00b7 \u001b[0m\u001b[1m\u001b[38;5;6mg/G\u001b[0m top/end\u001b[0m\u001b[2m \u00b7 \u001b[0m\u001b[1m\u001b[38;5;6m?\u001b[0m all keys\r\n\u001b[0m\u001b[7m following new output                                      \u001b[0m\u001b[1m\u001b[38;5;15m\u001b[48;5;5m gpt-oss-120b \u001b[0m\u001b[7m live \u00b7 cell 11/11 \u00b7 turn 3 \u00b7 \u001b[0m\u001b[1m\u001b[7m\u001b[38;5;3m\u25cf live\u001b[0m\u001b[0m"]
